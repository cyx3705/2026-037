<Project>
  <PropertyGroup>
    <!-- 版本的唯一真源。module.manifest.json 与根 project.manifest.json 必须同值，
         打包脚本与合同检查会逐一比对——宿主对版本不一致的处理是静默跳过整个模块。 -->
    <HistoryExemplumVersion>0.1.1</HistoryExemplumVersion>
    <!-- 只用注册器 + 命令总线 + CommandContext.Progress 时是 5.1.2（冻结接入面）；
         用到 IModuleContext.Log 改 5.5.0，用到 RegisterFrontend 改 5.4.0。 -->
    <MinimumHistoryVulcanVersion>5.1.2</MinimumHistoryVulcanVersion>
    <VersionPrefix>$(HistoryExemplumVersion)</VersionPrefix>
    <Version>$(HistoryExemplumVersion)</Version>
    <AssemblyVersion>$(HistoryExemplumVersion).0</AssemblyVersion>
    <FileVersion>$(HistoryExemplumVersion).0</FileVersion>
    <InformationalVersion>$(HistoryExemplumVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
